# =============================================================================
# GHD Imports — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure as mesmas chaves em
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# =============================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Chave pública (anon / publishable). Segura no browser: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Chave secreta (service_role / secret). NUNCA prefixar com NEXT_PUBLIC_.
# Usada apenas no servidor para registar encomendas (função create_order).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# URL pública da loja (SEO, sitemap, links absolutos). Sem barra final.
NEXT_PUBLIC_SITE_URL=https://www.ghdimports.com.br

# Opcional: sal usado para anonimizar o IP no rate limiting de encomendas.
# Gere com: openssl rand -hex 32
ORDER_IP_SALT=
